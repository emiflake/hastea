cabal-version:   3.4
name:            hastea-html
version:         0.1.0.0
synopsis:        HTML elements, attributes and events for Hastea
description:
  The view layer of the Hastea web framework: typed functions for every
  HTML element, their attributes and events, and decoders for reading event
  data.

  This package is pure Haskell. It does not depend on JavaScript, so it
  builds with any GHC and its trees can be rendered to a string or inspected
  in tests. The @hastea@ package renders them to the DOM.

homepage:        https://github.com/emiflake/hastea
bug-reports:     https://github.com/emiflake/hastea/issues
author:          emiflake
maintainer:      emiflake
category:        Web
build-type:      Simple
tested-with:     GHC ==9.4.7 || ==9.14.1

source-repository head
  type:     git
  location: https://github.com/emiflake/hastea.git
  subdir:   hastea-html

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat
  build-depends:    base >=4.16 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Hastea.Html
    Hastea.Html.Attributes
    Hastea.Html.Decode
    Hastea.Html.Events
    Hastea.Html.Internal
    Hastea.Html.Render

test-suite hastea-html-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:  Tables
  build-depends:  hastea-html
