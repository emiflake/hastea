-- For editors only. HLS cannot use GHC's wasm cross-compiler, so hie.yaml
-- points it here, where the package is loaded with your ordinary GHC
-- instead.
--
-- hastea-html and hastea-component are pure Haskell and build as they are.
-- The rest imports from JavaScript, which an ordinary GHC rejects: the
-- editor flag has those imports replaced by stand-ins while compiling, by
-- hastea-ffi-stand-in from hastea-cli/, which has to be on the PATH. What
-- comes out typechecks and cannot run.
--
-- To check that everything typechecks this way, as HLS will see it:
--
--   cabal build all --project-file=cabal.project.hls
packages: .
tests: True

package hastea
  flags: +editor
