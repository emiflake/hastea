packages: .

-- Hastea only builds for WebAssembly, so always use the wasm cross-compiler
-- (from ghc-wasm-meta). This lets plain `cabal build` and HLS work without
-- the wasm32-wasi-cabal wrapper.
with-compiler: wasm32-wasi-ghc
with-hc-pkg: wasm32-wasi-ghc-pkg

-- Test suites are wasm modules too; run them with wasmtime (also part of
-- ghc-wasm-meta).
package hastea
  tests: True
  test-wrapper: wasmtime
