cabal-version:   3.4
name:            hastea
version:         0.1.0.0
synopsis:        A tasty hasty Elm-Architecture web framework for GHC's WebAssembly backend
description:
  Hastea is a small web framework inspired by The Elm Architecture. It
  compiles to WebAssembly with GHC's wasm backend and talks to the DOM
  through the JavaScript FFI.

homepage:        https://github.com/emiflake/hastea
bug-reports:     https://github.com/emiflake/hastea/issues
author:          emiflake
maintainer:      emiflake
category:        Web
build-type:      Simple
tested-with:     GHC ==9.14.1
extra-doc-files: README.md

source-repository head
  type:     git
  location: https://github.com/emiflake/hastea.git

-- For editors. HLS cannot use the wasm cross-compiler, so hie.yaml and
-- cabal.project.hls have it load the package with an ordinary GHC and this
-- flag. The components that import from JavaScript are then built with a
-- preprocessor that puts a stand-in in the place of every import
-- (hastea-ffi-stand-in, from hastea-cli, which has to be on the PATH). The
-- result typechecks, and cannot run.
flag editor
  description:
    Typecheck the components that use the JavaScript FFI with an ordinary GHC

  default:     False
  manual:      True

common shared
  default-language:   GHC2021

  -- Records are accessed as `record.field`. Fields do not also become
  -- functions, so they can share a name with other things: a model can have
  -- a field called `title` next to the `title` element.
  --
  -- All text is Data.Text, so string literals are overloaded.
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:      -Wall -Wcompat

-- Components that use the JavaScript FFI of the wasm backend. An ordinary
-- GHC can only typecheck them, and only with the editor flag.
common wasm-only
  if !arch(wasm32)
    if flag(editor)
      ghc-options: -F -pgmF hastea-ffi-stand-in

    else
      buildable: False

-- Link as a WASI reactor exporting the entry point called by index.js.
common reactor
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"

-- HTML elements, attributes and events, decoders for event data, rendering
-- to a string and diffing. Pure Haskell with no JavaScript, so it can be
-- used and tested anywhere.
-- Depend on it alone with `build-depends: hastea:hastea-html`.
library hastea-html
  import:          shared
  visibility:      public
  hs-source-dirs:  hastea-html/src
  exposed-modules:
    Hastea.Html
    Hastea.Html.Attributes
    Hastea.Html.Decode
    Hastea.Html.Diff
    Hastea.Html.Events
    Hastea.Html.Internal
    Hastea.Html.Render
    Hastea.Svg
    Hastea.Svg.Attributes

  build-depends:
    , base        >=4.16 && <5
    , containers  >=0.6 && <0.9
    , text        >=2.0 && <2.2

-- Components with state of their own, and the commands and subscriptions
-- through which they have effects. Also pure Haskell: it describes what
-- should happen and keeps track of state, and leaves the page to hastea.
library hastea-component
  import:          shared
  visibility:      public
  hs-source-dirs:  hastea-component/src
  exposed-modules:
    Hastea.Cmd
    Hastea.Component
    Hastea.Component.Internal
    Hastea.Internal.Sub
    Hastea.Sub

  build-depends:
    , base
    , containers
    , hastea:hastea-html
    , text

-- The test harness and helpers that both test suites use. A library of its
-- own, so that no module belongs to two components (which HLS cannot load).
library test-support
  import:          shared
  hs-source-dirs:  hastea-html/support
  exposed-modules: Support
  build-depends:
    , base
    , hastea:hastea-html
    , text

test-suite hastea-html-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: hastea-html/test
  main-is:        Main.hs
  other-modules:  Tables
  build-depends:
    , base
    , hastea:{hastea-html, test-support}
    , text

test-suite hastea-component-test
  import:         shared
  type:           exitcode-stdio-1.0

  hs-source-dirs: hastea-component/test
  main-is:        ComponentTest.hs
  build-depends:
    , base
    , hastea:{hastea-component, hastea-html, test-support}
    , text

-- The runtime: renders views to the DOM and runs the update loop.
library
  import:          shared, wasm-only
  hs-source-dirs:  hastea-core/src
  exposed-modules:
    Hastea.App
    Hastea.Async
    Hastea.Decode
    Hastea.Dom
    Hastea.Http
    Hastea.Root
    Hastea.Time

  -- Re-export the view layer so that depending on hastea is enough to write
  -- an app.
  reexported-modules:
    , Hastea.Cmd
    , Hastea.Component
    , Hastea.Html
    , Hastea.Html.Attributes
    , Hastea.Html.Events
    , Hastea.Sub
    , Hastea.Svg
    , Hastea.Svg.Attributes

  other-modules:
    Hastea.Internal.Commit
    Hastea.Internal.Foreign.DOM
    Hastea.Internal.Foreign.Effects
    Hastea.Internal.Foreign.FFI
    Hastea.Internal.Foreign.Types

  build-depends:
    , base                                    >=4.20 && <5
    , containers                              >=0.6  && <0.9
    , hastea:{hastea-component, hastea-html}
    , text

  -- JSVal and its relatives come with the wasm backend. An ordinary GHC
  -- gets a stand-in for them.
  if arch(wasm32)
    build-depends: ghc-experimental

  else
    hs-source-dirs:  hastea-core/stand-in
    exposed-modules: GHC.Wasm.Prim

executable hastea-todomvc
  import:         shared, wasm-only, reactor
  hs-source-dirs: examples/todomvc
  main-is:        Main.hs
  other-modules:
    Example.TodoMVC.TodoMVC
    Example.TodoMVC.Todos

  build-depends:
    , base
    , containers  >=0.6 && <0.9
    , hastea
    , text

executable hastea-react-comparison
  import:         shared, wasm-only, reactor
  hs-source-dirs: examples/ReactComparison
  main-is:        Main.hs
  other-modules:
    ReactComparison.Accordion
    ReactComparison.Bio
    ReactComparison.Counter
    ReactComparison.Focus
    ReactComparison.Greeting
    ReactComparison.Headings
    ReactComparison.ProductTable
    ReactComparison.Quiz
    ReactComparison.Stopwatch
    ReactComparison.StopwatchRoot
    ReactComparison.Tasks

  build-depends:
    , base
    , hastea
    , text

executable hastea-benchmark
  import:         shared, wasm-only, reactor
  hs-source-dirs: benchmark
  main-is:        Main.hs
  build-depends:
    , base
    , hastea
    , text
